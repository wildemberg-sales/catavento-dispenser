# Postgres (docker-compose local)
DATABASE_URL=postgres://catavento:catavento@localhost:5432/catavento_dev
PGPOOL_MAX=10

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Motor de fila / abandono
ABANDONMENT_CHECK_INTERVAL_MS=60000
ABANDONMENT_TIMEOUT_MINUTES=15

# Operadores online (Monitor) — sweep de quem parou de mandar heartbeat
OPERATOR_ONLINE_SWEEP_INTERVAL_MS=30000
OPERATOR_ONLINE_TIMEOUT_MINUTES=3

# Servidor
PORT=3000
LOG_LEVEL=info
